# Copy to .env next to docker-compose.yml and fill in.

# Postgres password used by both the db and api services.
DB_PASSWORD=change-me

# Kitsu public client credentials (see .planning/02-external-apis.md).
# Defaults are Kitsu's documented public OAuth client.
KITSU_CLIENT_ID=dd031b32d2f56c990b1425efe6c42ad847e7fe3ab46bf1299f05ecd856bdb7dd
KITSU_CLIENT_SECRET=54d7307928f63414defd96399fc31ba847961ceaecef3a5fd93144e960c0e151

# stub: accept any non-empty credentials (development / pre-S2).
# real: perform the actual Kitsu OAuth password grant.
KITSU_AUTH_MODE=stub

# Optional: override the AnimeThemes API origin. Leave unset to use the public
# host (https://api.animethemes.moe). Point this at an operator-controlled
# mirror/reverse-proxy if the public host hard-blocks this server's IP
# (Cloudflare 403). See "Operational notes" in README.md.
# ANIMETHEMES_BASE_URL=https://api.animethemes.moe

# Media catalog rollout switches. Keep both false for the existing TV Size-only
# server behavior. Discovery cannot run unless MUSIC_PROVIDER=LIDARR.
MUSIC_CATALOG_ENABLED=false
MUSIC_DISCOVERY_ENABLED=false
MUSIC_PROVIDER=disabled

# Required only when MUSIC_PROVIDER=LIDARR. Anime Ongaku sends the API key only
# in an X-Api-Key request header; never place it in LIDARR_BASE_URL.
# LIDARR_BASE_URL=http://lidarr:8686
# LIDARR_API_KEY=change-me
# LIDARR_ROOT_FOLDER_PATH=/music
# LIDARR_SHARED_ROOT=/srv/animeongaku/music
# LIDARR_QUALITY_PROFILE_ID=1
# LIDARR_METADATA_PROFILE_ID=1
# LIDARR_OWNERSHIP_TAG_ID=
# Set both prefix values only when Lidarr's file paths differ from the shared
# server mount. Leave both unset when the paths already agree.
# LIDARR_PATH_PREFIX_FROM=/downloads
# LIDARR_PATH_PREFIX_TO=/srv/downloads
